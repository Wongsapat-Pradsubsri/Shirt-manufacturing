---
// ส่วนหัวบทความ — ปุ่มกลับ + แท็กแรก/วันที่ + ชื่อเรื่อง + การ์ดผู้เขียน
interface Props {
  title: string;
  author: string;
  tags: string[];
  publishedAt: Date;
}

const { title, author, tags, publishedAt } = Astro.props;
const hasTags = tags.length > 0;
---

<div class="max-w-4xl mx-auto mt-4 mb-12 px-4">
  <div class="mb-10">
    <a href="/blog" class="inline-flex items-center text-[0.7rem] font-bold tracking-widest uppercase text-[#3d4536] no-underline border-b border-transparent hover:border-[#3d4536] transition-all duration-300">
      ← กลับไปหน้าบทความ
    </a>
  </div>

  <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 pb-10">
    <div class="flex-1">
      <div class="flex items-center gap-3 text-sm mb-5">
        {hasTags && (
          <span class="inline-flex items-center px-3.5 py-1.5 rounded-none text-[0.58rem] font-bold tracking-widest uppercase bg-[#faf9f6]/80 border border-[#3d4536]/40 text-[#3d4536]">
            {tags[0]}
          </span>
        )}
        {hasTags && <span class="w-1 h-1 bg-[#3d4536]/40"></span>}
        <time datetime={publishedAt.toISOString()} class="text-xs font-bold uppercase tracking-wider text-gray-500 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          {publishedAt.toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-normal text-gray-900 tracking-tight leading-[1.18] font-serif">
        {title}
      </h1>
    </div>

    <div class="shrink-0 flex items-center gap-4 bg-[#faf9f6]/50 p-2.5 pr-6 rounded-none border border-[#e5e3db]/60 relative top-2">
      <div class="w-12 h-12 bg-white flex items-center justify-center text-[#3d4536] border border-[#e5e3db]/60 rounded-none">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
      <div>
        <p class="text-[9px] text-gray-400 font-bold uppercase tracking-widest mb-0.5">Written By</p>
        <p class="text-xs font-bold text-gray-900">{author}</p>
      </div>
    </div>
  </div>
</div>
