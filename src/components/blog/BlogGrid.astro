---
// กริดบทความ — ดึงจาก collection จริง, เรียงใหม่สุดก่อน, ซ่อนเองถ้าไม่มีบทความ
// ใช้ได้ทั้งหน้า list (บทความล่าสุด) และท้าย detail (บทความที่เกี่ยวข้อง)
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import type { CollectionEntry } from 'astro:content';

interface Props {
  /** หัวข้อ section */
  title?: string;
  /** id บทความที่ต้องการตัดออก (เช่น บทความที่กำลังอ่านอยู่) */
  excludeId?: string;
  /** จำนวนสูงสุดที่แสดง */
  limit?: number;
  /** แสดงลิงก์ "ดูทั้งหมด" หรือไม่ */
  showViewAll?: boolean;
  /** ข้อมูลบทความที่ถูกกรองมาแล้ว (ถ้ามี) */
  posts?: CollectionEntry<'blog'>[];
  /** override คลาสคอลัมน์ของกริด (เช่นคอลัมน์แคบที่มี sidebar ใช้ 2 คอลัมน์) */
  gridClass?: string;
}

const {
  title = 'บทความล่าสุด',
  excludeId,
  limit = 4,
  showViewAll = true,
  posts: propPosts,
  gridClass = 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4',
} = Astro.props;

const posts = propPosts || (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.id !== excludeId)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, limit);
---

{posts.length > 0 && (
  <section class="mb-32">
    {(title || showViewAll) && (
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-14">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight">{title}</h2>
        {showViewAll && (
          <a href="/blog" class="text-gray-600 font-medium hover:text-gray-900 transition-colors inline-flex items-center gap-1">
            ดูทั้งหมด
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        )}
      </div>
    )}

    <div class:list={["grid gap-8 lg:gap-10", gridClass]}>
      {posts.map((post) => {
        const d = post.data;
        return (
          <a href={`/blog/${post.id}`} class="group flex flex-col bg-white border border-[#e5e3db]/60 hover:border-[#3d4536] transition-colors duration-300 no-underline text-[#242622]">
            <div class="relative overflow-hidden bg-[#f4f3ee] aspect-[4/3] rounded-none">
              {d.cover && (
                <Image
                  src={d.cover}
                  alt={d.coverAlt || d.title}
                  widths={[400, 600, 800]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
                  loading="lazy"
                  class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
                />
              )}
            </div>
            <div class="flex flex-col mt-4 px-4 pb-5">
              <div class="flex justify-between items-baseline mb-2">
                {d.tags[0] && (
                  <span class="text-[0.58rem] font-bold tracking-widest uppercase text-[#3d4536] bg-[#faf9f6]/80 border border-[#3d4536]/40 px-2 py-0.5 rounded-none">{d.tags[0]}</span>
                )}
                <span class="text-[0.6rem] font-bold tracking-wider text-[#9b9f96] uppercase">{d.publishedAt.toLocaleDateString('th-TH', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              </div>
              <h3 class="text-xs font-bold uppercase tracking-wider text-[#242622] group-hover:text-[#3d4536] transition-colors duration-300 mb-3 line-clamp-2 leading-relaxed pt-2.5 border-t border-[#e5e3db]/60">{d.title}</h3>
              <span class="text-[0.62rem] font-bold tracking-widest text-[#3d4536] uppercase opacity-0 group-hover:opacity-100 transition-opacity duration-300 inline-flex items-center gap-1 mt-auto">อ่านบทความ <span class="text-[0.75rem]">→</span></span>
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}
