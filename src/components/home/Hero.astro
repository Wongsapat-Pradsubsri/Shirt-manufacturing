---
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import heroImg from '@/assets/home/hero-img.png';
import { SITE } from '@/consts';
---

{/* Hero Section - Columns Layout (Left text, Right person image) */}
<div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start relative pt-0 pb-12 md:pt-0 md:pb-20 max-w-[1200px] mx-auto px-6 z-10">

  {/* Large Faint Watermark behind the content */}
  <div class="absolute left-6 top-10 text-[9rem] md:text-[14rem] font-serif font-black text-[#3d4536]/2 uppercase select-none pointer-events-none -z-10 tracking-[0.15em] leading-none">
    THANA
  </div>

  {/* Left Column: Typography & CTAs */}
  <div class="lg:col-span-7 flex flex-col items-start text-left pt-6 md:pt-12">
    
    {/* Header Info */}
    <div class="inline-flex items-center gap-3 text-[#3d4536] text-[0.65rem] font-bold tracking-[0.25em] uppercase mb-6 reveal">
      <span class="w-6 h-[1px] bg-[#3d4536]"></span>
      โรงงานผลิตเสื้อผ้าและงานสกรีนครบวงจร
    </div>

    <h1 class="text-4xl sm:text-5xl lg:text-5xl leading-[1.18] font-normal tracking-tight text-gray-900 mb-6 flex flex-col reveal" style="transition-delay: 150ms">
      <span>โรงงานรับผลิตเสื้อครบวงจร</span>
      <span class="text-[#656a60] font-light italic text-2xl sm:text-3xl mt-3">ครบจบในที่เดียว ตั้งแต่เลือกผ้าถึงงานสกรีน</span>
    </h1>

    <p class="text-gray-600 text-sm leading-relaxed max-w-[540px] mb-8 pl-4 border-l border-[#3d4536]/40 reveal" style="transition-delay: 300ms">
      บริการรับผลิตเสื้อผ้าครบวงจร ยกระดับแบรนด์ของคุณด้วยคุณภาพระดับมาตรฐานสากล ควบคุมงานด้วยระบบบริหารจัดการ QPC
    </p>

    <div class="flex flex-wrap gap-4 reveal" style="transition-delay: 450ms">
      <a href={SITE.contact.lineLink} class="inline-flex items-center bg-[#06C755] text-white px-8 py-3.5 text-[0.72rem] font-bold tracking-widest uppercase transition-all duration-300 hover:bg-[#05b34c] hover:translate-y-[-1px] rounded-none" target="_blank" rel="noopener">
        ทัก LINE {SITE.contact.line}
      </a>
      <a href={SITE.contact.phoneLink} class="inline-flex items-center bg-transparent text-[#242622] border border-[#242622]/80 px-8 py-3.5 text-[0.72rem] font-bold tracking-widest uppercase transition-all duration-300 hover:bg-[#242622] hover:text-white hover:translate-y-[-1px] rounded-none">
        โทรติดต่อ {SITE.contact.phone}
      </a>
    </div>

    {/* Minimalist Stats/Specs Row to fill space and add editorial structure */}
    <div class="w-full border-t border-[#e5e3db]/85 pt-8 mt-14 grid grid-cols-3 gap-6 text-left reveal" style="transition-delay: 550ms">
      <div>
        <p class="text-[0.55rem] font-bold tracking-widest uppercase text-[#3d4536] mb-1.5">01 / MOQ</p>
        <h4 class="text-[0.72rem] font-bold text-[#242622] mb-1 uppercase tracking-wide">กำลังผลิตยืดหยุ่น</h4>
        <p class="text-[0.65rem] text-[#656a60] leading-relaxed">รองรับออเดอร์สร้างแบรนด์และองค์กรขนาดใหญ่</p>
      </div>
      <div class="border-l border-[#e5e3db]/80 pl-5">
        <p class="text-[0.55rem] font-bold tracking-widest uppercase text-[#3d4536] mb-1.5">02 / 3D GRAPHIC</p>
        <h4 class="text-[0.72rem] font-bold text-[#242622] mb-1 uppercase tracking-wide">ออกแบบม็อคอัพฟรี</h4>
        <p class="text-[0.65rem] text-[#656a60] leading-relaxed">เห็นภาพจำลองเสื้อ 3D จริงก่อนเริ่มงานผลิต</p>
      </div>
      <div class="border-l border-[#e5e3db]/80 pl-5">
        <p class="text-[0.55rem] font-bold tracking-widest uppercase text-[#3d4536] mb-1.5">03 / DELIVERY</p>
        <h4 class="text-[0.72rem] font-bold text-[#242622] mb-1 uppercase tracking-wide">จัดส่งตรงเวลานัด</h4>
        <p class="text-[0.65rem] text-[#656a60] leading-relaxed">ควบคุมคิวงานตามมาตรฐาน QPC ไร้กังวล</p>
      </div>
    </div>

  </div>

  {/* Right Column: Image Container (Man floating on body background) */}
  <div class="lg:col-span-5 relative flex flex-col items-center w-full max-w-[440px] mx-auto lg:mx-0 reveal-scale" style="transition-delay: 600ms">
    
    <Image
      src={heroImg}
      alt="โรงงานรับผลิตเสื้อผ้าครบวงจร งานตัดเย็บและสกรีนเสื้อ"
      widths={[440, 768]}
      sizes="(max-width: 1024px) 100vw, 440px"
      loading="eager"
      fetchpriority="high"
      class="w-full h-auto object-contain relative z-0 pointer-events-auto lg:-mt-4 transform lg:scale-105 origin-top"
      style="mask-image: linear-gradient(to bottom, black 85%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 85%, transparent 100%);"
    />

    {/* Brand Social Proof bar (Directly below/over the man, styled exactly like the user's mockup image) */}
    <div class="w-full bg-[#faf9f6]/95 border border-[#3d4536] p-4 rounded-none shadow-none flex items-center justify-between pointer-events-auto z-20 mt-4">
      <div class="flex items-center gap-3 text-gray-700">
        <Icon name="building-factory-2" size={16} class="text-[#3d4536]" />
        <Icon name="star" size={16} class="text-[#3d4536]" />
        <Icon name="shirt" size={16} class="text-[#3d4536]" />
      </div>
      <p class="text-[0.62rem] font-bold text-gray-800 uppercase tracking-widest">TRUSTED BY 500+ BRANDS</p>
    </div>

  </div>

</div>
