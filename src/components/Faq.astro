---
// คอมโพเนนต์ FAQ ที่ "มองเห็นได้บนหน้า" — zero-JS ด้วย <details>/<summary>
// เรนเดอร์จาก data ชุดเดียวกับ FAQPage JSON-LD (กัน schema drift ตามกฎ Google)
import type { FaqItem } from '@/lib/faq';

interface Props {
  items?: FaqItem[];
  /** หัวข้อของส่วน FAQ — ส่งสตริงว่างเพื่อซ่อนหัวข้อ */
  title?: string;
  /** คลาสของ <section> — override ระยะห่าง/ความกว้างต่อหน้าได้ (default mt-12) */
  class?: string;
}

const {
  items,
  title = 'คำถามที่พบบ่อย',
  class: className = 'py-24 max-w-[1200px] mx-auto',
} = Astro.props;
---

{/* ไม่มีข้อมูล/ว่าง → ไม่เรนเดอร์อะไรเลย */}
{items && items.length > 0 && (
  <section
    class:list={[className]}
    {...(title
      ? { 'aria-labelledby': 'faq-heading' }
      : { 'aria-label': 'คำถามที่พบบ่อย' })}
  >
    {title && (
      <div class="mb-14 text-center">
        <p class="text-[0.65rem] font-bold tracking-[0.25em] uppercase text-[#3d4536] mb-3">FAQ</p>
        <h2 id="faq-heading" class="scroll-mt-24 text-2xl md:text-3xl font-normal tracking-tight text-[#242622] font-serif">
          {title}
        </h2>
      </div>
    )}
    <div class="max-w-[800px] mx-auto divide-y divide-[#e5e3db] border-t border-b border-[#e5e3db]">
      {items.map((item) => (
        <details class="group">
          <summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-[#242622] list-none [&::-webkit-details-marker]:hidden py-5 hover:text-[#3d4536] transition-colors">
            <span class="text-sm md:text-base">{item.question}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4.5 w-4.5 shrink-0 text-[#9b9f96] transition-transform duration-200 group-open:rotate-180 group-open:text-[#3d4536]"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <p class="pb-6 text-[#656a60] text-[0.88rem] leading-relaxed pl-4 border-l border-[#3d4536]/30">
            {item.answer}
          </p>
        </details>
      ))}
    </div>
  </section>
)}
