---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  title: string;
  description?: string;
  image: ImageMetadata;
  imageAlt: string;
  tags?: string[];
  price: number;
}

const { id, title, description, image, imageAlt, tags = [], price } = Astro.props;
---

<a href={`/products/${id}/`} class="flex flex-col no-underline text-[#242622] group hover:-translate-y-1 transition-all duration-300">
  <div class="relative overflow-hidden bg-[#f4f3ee] aspect-[4/3] rounded-2xl border border-[#e5e3db]/60 shadow-sm">
    <Image 
      src={image} 
      alt={imageAlt} 
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-103" 
    />
  </div>
  <div class="flex flex-col mt-4">
    <h3 class="text-base font-bold text-[#242622] group-hover:text-[#3d4536] transition-colors duration-300 line-clamp-1">{title}</h3>
    <p class="text-xs text-[#656a60] font-semibold mt-1">เริ่มต้น {price}.- / ตัว</p>
    <span class="text-xs font-bold text-[#3d4536] inline-flex items-center gap-0.5 mt-2.5 group-hover:text-[#5f6a55] transition-colors duration-300">
      ดูรายละเอียดสินค้า 
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transform group-hover:translate-x-0.5 transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
      </svg>
    </span>
  </div>
</a>
