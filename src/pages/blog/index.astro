---
// ปิดหมวดหมู่ Blog ตามแผน — Redirect กลับหน้าหลักทันที
return Astro.redirect('/', 302);

import PageLayout from '@/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

// JSON-LD: Blog + Breadcrumb
const blogUrl = new URL('/blog/', Astro.site).toString();
const orgId = new URL('/#organization', Astro.site).toString();

const blogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'บทความและความรู้เรื่องเสื้อผ้า งานสกรีน และการทำแบรนด์',
  url: blogUrl,
  inLanguage: 'th-TH',
  publisher: { '@id': orgId },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'บทความ', item: blogUrl },
  ],
};
---

<PageLayout
  title="บทความและความรู้เรื่องเสื้อผ้า งานสกรีน และการทำแบรนด์"
  description="รวมบทความน่ารู้ เทรนด์แฟชั่น เทคนิคงานสกรีน และเคล็ดลับการทำแบรนด์เสื้อผ้า จากโรงงานผลิตเสื้อผ้าครบวงจร เสื้อแท้ (ธน พลัส 153)"
  jsonLd={[blogJsonLd, breadcrumbJsonLd]}
  activePath="blog"
>
  <!-- HERO -->
  <section class="text-center pt-8 pb-16 relative overflow-hidden">
    <p class="text-[0.65rem] font-bold tracking-[0.25em] uppercase text-[#3d4536] mb-3 reveal">Our Journal</p>
    <h1 class="text-4xl md:text-5xl font-normal tracking-tight text-[#242622] mb-6 relative z-10 font-serif reveal" style="transition-delay: 150ms">ความรู้เรื่องผ้าและงานสกรีน</h1>
    <p class="text-[#656a60] text-sm leading-relaxed max-w-[580px] mx-auto relative z-10 reveal" style="transition-delay: 300ms">จาก Thanaplus Academy อัปเดตเทรนด์แฟชั่น นวัตกรรมสิ่งทอ และเคล็ดลับการเริ่มต้นแบรนด์เสื้อผ้าของคุณเอง</p>
  </section>

  <!-- BLOG FEED ROWS -->
  <section class="pt-12 pb-16 border-t border-[#e5e3db]">
    <div class="flex flex-col gap-12">
      {posts.map((post) => {
        const d = post.data;
        return (
          <a href={`/blog/${post.id}/`} class="grid grid-cols-1 md:grid-cols-[1fr_1.8fr] gap-8 bg-white border border-[#e5e3db]/60 hover:border-[#3d4536] transition-all duration-300 no-underline text-[#242622] group reveal">
            <div class="h-[260px] overflow-hidden bg-[#f4f3ee]">
              {d.cover && (
                <Image
                  src={d.cover}
                  alt={d.coverAlt || d.title}
                  widths={[400, 600, 800]}
                  sizes="(max-width: 768px) 100vw, 33vw"
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
              )}
            </div>
            <div class="flex flex-col justify-center p-6 md:p-8 pr-12">
              <span class="inline-flex items-center gap-1.5 text-[0.62rem] font-bold tracking-widest uppercase text-[#3d4536] mb-3">
                ✦ {d.category}
              </span>
              <h3 class="text-lg md:text-xl font-bold tracking-tight text-[#242622] mb-3 group-hover:text-[#3d4536] transition-colors leading-snug font-sans">
                {d.title}
              </h3>
              <p class="text-[0.72rem] text-[#656a60] leading-relaxed mb-5 pt-3 border-t border-[#e5e3db]/60">
                {d.description}
              </p>
              <span class="text-[0.65rem] text-[#9b9f96] font-bold uppercase tracking-wider">
                {d.publishedAt.toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
            </div>
          </a>
        );
      })}
    </div>

    {posts.length === 0 && (
      <div class="text-center py-20 text-[#9b9f96]">
        <p class="text-xl">Coming soon...</p>
      </div>
    )}
  </section>
</PageLayout>
