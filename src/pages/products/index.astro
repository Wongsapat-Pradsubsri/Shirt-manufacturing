---
import PageLayout from '@/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import PortfolioCard from '@/components/products/PortfolioCard.astro';
import { SITE } from '@/consts';

// แคตตาล็อกแสดงผลงานรับผลิตเสื้อผ้าพรีเมียมของโรงงาน


const products = (await getCollection('products')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

// JSON-LD ItemList Schema for better SEO of category pages
const itemListElement = products.map((product, index) => ({
  '@type': 'ListItem',
  position: index + 1,
  name: product.data.title,
  url: new URL(`/products/${product.id}/`, Astro.site).toString(),
  image: new URL(product.data.image.src, Astro.site).toString(),
}));

const listJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement,
};

// Breadcrumb JSON-LD
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'ผลงาน', item: new URL('/products/', Astro.site).toString() },
  ],
};
---

<PageLayout
  title="ผลงานการผลิตเสื้อ ผลงานสกรีน เสื้อยืดพรีเมี่ยม เสื้อโปโล เสื้อแจ็คเก็ตพรีเมียม เสี้อกีฬา กระเป๋าผ้า เสื้อรุ่น"
  description="ดูผลงานการผลิตเสื้อยืด โปโล แจ็คเก็ต เสื้อกีฬา งานสกรีนคุณภาพจาก ธนพลัส 153 จำกัด รับผลิตครบวงจร"  jsonLd={[listJsonLd, breadcrumbJsonLd]}
  activePath="products"
>
  <!-- HERO -->
  <section class="text-center pt-8 pb-16 relative overflow-hidden">
    <p class="text-[0.65rem] font-bold tracking-[0.25em] uppercase text-[#3d4536] mb-3 reveal">Portfolio</p>
    <h1 class="text-4xl md:text-5xl font-normal tracking-tight text-[#242622] mb-6 relative z-10 font-serif reveal" style="transition-delay: 150ms">แคตตาล็อกผลงานของเรา</h1>
    <p class="text-[#656a60] text-sm leading-relaxed max-w-[580px] mx-auto relative z-10 reveal" style="transition-delay: 300ms">ตัวอย่างงานผลิตเสื้อยืดพรีเมียม เสื้อโปโลปักลาย และชุดกีฬาหลากหลายสเปกเนื้อผ้าและเฉดสี ที่เราส่งมอบให้กับแบรนด์และองค์กรชั้นนำ</p>
  </section>

  <!-- PRODUCTS GRID -->
  <section class="pt-12 pb-16 border-t border-[#e5e3db]">
    <div class="mb-10 reveal">
      <h2 class="text-2xl font-bold text-[#242622]">ผลงานสั่งผลิตล่าสุด / Latest Products</h2>
      <p class="text-xs text-[#656a60] mt-1.5 font-medium">ตัวอย่างงานรับผลิตและผลงานการสั่งตัด/สกรีนจริงจากแบรนด์และองค์กรต่าง ๆ</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
      {
        products.map((product, idx) => (
          <div class="reveal" style={`transition-delay: ${idx * 50}ms`}>
            <PortfolioCard 
              id={product.id}
              title={product.data.title}
              description={product.data.description}
              image={product.data.image}
              imageAlt={product.data.imageAlt}
              tags={product.data.tags}
              price={product.data.price}
            />
          </div>
        ))
      }
    </div>
    
    {products.length === 0 && (
      <div class="text-center py-20 text-[#9b9f96]">
        <p class="text-xl">Coming soon...</p>
      </div>
    )}
  </section>

  <!-- TESTIMONIALS SECTION -->
  <section class="pt-16 pb-20 border-t border-[#e5e3db]/85 reveal">
    <div class="mb-16 text-center">
      <p class="text-[0.65rem] font-bold tracking-[0.25em] uppercase text-[#3d4536] mb-3">Testimonials</p>
      <h2 class="text-2xl md:text-3xl font-normal tracking-tight text-[#242622] font-serif">เสียงตอบรับความไว้วางใจ</h2>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-[1100px] mx-auto">
      <!-- Card 1 -->
      <div class="bg-white border border-[#e5e3db]/60 p-8 rounded-none transition-colors duration-300 hover:border-[#3d4536]">
        <div class="text-[#3d4536] text-[0.65rem] font-semibold tracking-widest mb-4">✦ ✦ ✦ ✦ ✦</div>
        <p class="text-[0.7rem] text-[#656a60] leading-relaxed mb-6">"คุณภาพเสื้อจากโรงงานดีเกินคาดมาก งานตัดเย็บตะเข็บเนี้ยบ งานสกรีนออกมาคมชัดเป๊ะทุกตัว ทีมงานดูแลตั้งแต่ขึ้นดีไซน์ Mockup 3D ให้ดูก่อนตัดสินใจ แนะนำเลยครับสำหรับสร้างแบรนด์!"</p>
        <div class="border-t border-[#e5e3db]/60 pt-4 flex items-center gap-3">
          <div class="w-8 h-8 bg-[#f4f3ee] border border-[#e5e3db]/60 flex items-center justify-center font-bold text-xs text-[#242622] rounded-none">N</div>
          <div>
            <h4 class="text-xs font-bold text-[#242622]">คุณนภัส ว.</h4>
            <p class="text-[0.65rem] text-[#9b9f96]">เจ้าของแบรนด์เสื้อแฟชั่น</p>
          </div>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="bg-white border border-[#e5e3db]/60 p-8 rounded-none transition-colors duration-300 hover:border-[#3d4536]">
        <div class="text-[#3d4536] text-[0.65rem] font-semibold tracking-widest mb-4">✦ ✦ ✦ ✦ ✦</div>
        <p class="text-[0.7rem] text-[#656a60] leading-relaxed mb-6">"สั่งทำเสื้อยูนิตและทีมพนักงานกว่า 500 ตัว ประทับใจมาก ทรงเสื้อปกโปโลสวยตรงใจ ไหมปักโลโก้แน่นหนา ซักหลายรอบก็ยังคงทนไม่ขึ้นขุย กำหนดคิวส่งมอบรวดเร็วตรงเวลาตามมาตรฐาน QPC"</p>
        <div class="border-t border-[#e5e3db]/60 pt-4 flex items-center gap-3">
          <div class="w-8 h-8 bg-[#f4f3ee] border border-[#e5e3db]/60 flex items-center justify-center font-bold text-xs text-[#242622] rounded-none">P</div>
          <div>
            <h4 class="text-xs font-bold text-[#242622]">คุณภูริ ก.</h4>
            <p class="text-[0.65rem] text-[#9b9f96]">ผู้จัดการฝ่ายจัดซื้อองค์กร</p>
          </div>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="bg-white border border-[#e5e3db]/60 p-8 rounded-none transition-colors duration-300 hover:border-[#3d4536]">
        <div class="text-[#3d4536] text-[0.65rem] font-semibold tracking-widest mb-4">✦ ✦ ✦ ✦ ✦</div>
        <p class="text-[0.7rem] text-[#656a60] leading-relaxed mb-6">"เป็นโรงงานที่มีตัวเลือกเนื้อผ้าที่ตอบโจทย์หลากหลายมาก ตั้งผ้าคอตตอนพรีเมียมไปจนถึงผ้ากีฬาระบายอากาศ ทีมออกแบบดูแลและประเมินงบประมาณให้อย่างโปร่งใส คุ้มค่าที่สุด"</p>
        <div class="border-t border-[#e5e3db]/60 pt-4 flex items-center gap-3">
          <div class="w-8 h-8 bg-[#f4f3ee] border border-[#e5e3db]/60 flex items-center justify-center font-bold text-xs text-[#242622] rounded-none">L</div>
          <div>
            <h4 class="text-xs font-bold text-[#242622]">คุณลออ อ.</h4>
            <p class="text-[0.65rem] text-[#9b9f96]">นักการตลาดผลิตภัณฑ์สิ่งทอ</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
