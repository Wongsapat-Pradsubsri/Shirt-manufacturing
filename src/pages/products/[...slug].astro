---
import PageLayout from '@/layouts/PageLayout.astro';
import { getCollection, render } from 'astro:content';

import ProductGallery from '@/components/products/ProductGallery.astro';
import RelatedServices from '@/components/RelatedServices.astro';
import Faq from '@/components/Faq.astro';
import { buildFaqJsonLd } from '@/lib/faq';
import { SITE } from '@/consts';

// SSG: สร้างหน้าทุกสินค้า ณ build time
export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const d = product.data;

// JSON-LD แบบ Product (ดีต่อ SEO/Rich results)
const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.title,
  description: d.description,
  image: new URL(d.image.src, Astro.site).toString(),
  brand: {
    '@type': 'Brand',
    name: SITE.name,
  },
  offers: {
    '@type': 'Offer',
    url: new URL(Astro.url.pathname, Astro.site).toString(),
    priceCurrency: 'THB',
    price: d.price,
    priceValidUntil: '2026-12-31',
    availability: d.inStock
      ? 'https://schema.org/InStock'
      : 'https://schema.org/OutOfStock',
    itemCondition: 'https://schema.org/NewCondition',
  },
};

// Breadcrumb JSON-LD — หน้าแรก → ผลงาน → สินค้านี้ (จับคู่กับ Product ตาม json-ld reference)
// ใช้ trailing slash ให้ตรง canonical (Astro.url.pathname ของหน้านี้ลงท้าย / อยู่แล้ว)
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'ผลงาน', item: new URL('/products/', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: d.title, item: new URL(Astro.url.pathname, Astro.site).toString() },
  ],
};

// FAQPage JSON-LD จาก frontmatter (null ถ้าไม่มี faq) — ต่อท้าย Product ในหน้าเดียวได้
const faqJsonLd = buildFaqJsonLd(d.faq);

// กรองรูปภาพที่ซ้ำซ้อนออกเพื่อป้องกันการแสดงรูปหน้าปกซ้ำใน Gallery Slide
const uniqueImages = [];
const seen = new Set();
const allImages = [d.image, ...(d.gallery || [])];
for (const img of allImages) {
  if (img && !seen.has(img.src)) {
    seen.add(img.src);
    uniqueImages.push(img);
  }
}
const showSizeGuide = !d.tags.includes('bag');
---

<PageLayout
  title={d.title}
  description={d.description}
  type="product"
  image={d.image.src}
  jsonLd={[productJsonLd, breadcrumbJsonLd, ...(faqJsonLd ? [faqJsonLd] : [])]}
>
  <div class="mx-auto max-w-7xl">
    <div class="mb-12">
      <a href="/products/" class="inline-flex items-center text-[0.7rem] font-bold tracking-widest uppercase text-[#3d4536] no-underline border-b border-transparent hover:border-[#3d4536] transition-all duration-300">
        ← กลับไปแคตตาล็อกผลงาน
      </a>
    </div>

    <div class="max-w-3xl mx-auto text-center mb-16">
      <span class="inline-flex items-center gap-1.5 text-[0.62rem] font-bold tracking-widest uppercase text-[#3d4536] mb-3">
        ✦ ผลงานการผลิตของเรา
      </span>
      <h1 class="text-3xl md:text-4xl font-normal tracking-tight text-[#242622] mb-6 font-serif">{d.h1 || d.title}</h1>
      {d.price > 0 && (
        <p class="text-2xl font-semibold text-[#3d4536] mb-6">
          ฿{d.price.toLocaleString('th-TH')}
        </p>
      )}
      <div class="text-[0.75rem] text-[#656a60] leading-relaxed max-w-[600px] mx-auto pt-4 border-t border-[#e5e3db]/60">
        <p>{d.description}</p>
      </div>
      <article class="prose prose-neutral mx-auto mt-8 max-w-none prose-headings:font-bold prose-a:text-primary text-left">
        <Content />
      </article>

      <!-- Size Guide Button & Modal Trigger -->
      {showSizeGuide && (
        <div class="mt-8 pt-6 border-t border-[#e5e3db]/60 flex justify-center">
          <button id="btn-sizeguide" class="inline-flex items-center gap-2 px-6 py-3 bg-white border border-[#e5e3db] text-[#3d4536] font-bold text-xs tracking-wider uppercase hover:bg-[#3d4536] hover:text-white transition-all duration-300 rounded-xl shadow-sm cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ruler"><path d="M5 13v-2"/><path d="M9 13V9"/><path d="M13 13v-2"/><path d="M17 13V9"/><path d="m15 5 6 6-12 12-6-6Z"/></svg>
            ตารางแนะนำขนาดไซซ์ (Size Guide)
          </button>
        </div>
      )}
    </div>

    <!-- Size Guide Dialog -->
    {showSizeGuide && (
      <dialog id="sizeguide-modal" class="backdrop:bg-black/75 bg-transparent p-0 m-auto max-w-[500px] w-[calc(100%-2rem)] border-none outline-none overflow-hidden rounded-2xl shadow-2xl">
        <div class="bg-[#faf9f6] border border-[#e5e3db] p-6 md:p-8 flex flex-col relative text-[#242622]">
          <!-- Close Button -->
          <button id="sizeguide-close" class="absolute top-4 right-4 p-2 bg-[#f4f3ee] hover:bg-[#e5e3db] rounded-full transition-colors cursor-pointer text-[#3d4536]">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>

          <h3 class="text-lg font-bold font-serif mb-2">ตารางแนะนำขนาดไซซ์ (Size Guide)</h3>
          <p class="text-[0.7rem] text-[#656a60] mb-6">ตารางวัดขนาดสัดส่วนมาตรฐานสากล (หน่วยวัด: นิ้ว)</p>

          <div class="overflow-x-auto border border-[#e5e3db] rounded-xl bg-white mb-6">
            <table class="w-full text-left border-collapse text-xs">
              <thead>
                <tr class="bg-[#f4f3ee] border-b border-[#e5e3db] text-[#3d4536] font-bold">
                  <th class="p-3">ไซซ์ (Size)</th>
                  <th class="p-3">รอบอก (Chest)</th>
                  <th class="p-3">ความยาว (Length)</th>
                </tr>
              </thead>
              <tbody class="font-medium text-[#242622] divide-y divide-[#e5e3db]/60">
                <tr>
                  <td class="p-3 font-bold bg-[#faf9f6]">S</td>
                  <td class="p-3">38 นิ้ว</td>
                  <td class="p-3">27 นิ้ว</td>
                </tr>
                <tr>
                  <td class="p-3 font-bold bg-[#faf9f6]">M</td>
                  <td class="p-3">40 นิ้ว</td>
                  <td class="p-3">28 นิ้ว</td>
                </tr>
                <tr>
                  <td class="p-3 font-bold bg-[#faf9f6]">L</td>
                  <td class="p-3">42 นิ้ว</td>
                  <td class="p-3">29 นิ้ว</td>
                </tr>
                <tr>
                  <td class="p-3 font-bold bg-[#faf9f6]">XL</td>
                  <td class="p-3">44 นิ้ว</td>
                  <td class="p-3">30 นิ้ว</td>
                </tr>
                <tr>
                  <td class="p-3 font-bold bg-[#faf9f6]">XXL</td>
                  <td class="p-3">48 นิ้ว</td>
                  <td class="p-3">31 นิ้ว</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="bg-[#3d4536]/5 border border-[#3d4536]/15 p-4 rounded-xl flex gap-3 text-left">
            <div class="mt-0.5 text-[#3d4536] shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            </div>
            <div class="flex flex-col">
              <span class="text-[0.7rem] font-bold text-[#3d4536]">คำแนะนำในการสั่งผลิต</span>
              <span class="text-[0.65rem] text-[#656a60] mt-0.5 leading-relaxed">ขนาดรอบอกและความยาวอาจมีค่าความคลาดเคลื่อนจากการตัดเย็บจริง (Tolerance) ประมาณ +/- 0.5 ถึง 1 นิ้ว สามารถติดต่อเจ้าหน้าที่เพื่อขอรับตัวอย่างไซซ์เสื้อจริงไปเทียบก่อนตัดผลิตได้ครับ</span>
            </div>
          </div>
        </div>
      </dialog>
    )}

    {/* Full Masonry Gallery */}
    <ProductGallery images={uniqueImages} altPrefix={d.title} />

    {/* FAQ ที่มองเห็นได้ — เรนเดอร์จาก data เดียวกับ FAQPage JSON-LD */}
    <div class="max-w-3xl mx-auto">
      <Faq items={d.faq} />
    </div>

    {/* internal link product→pillar: ลิงก์ไปหน้าบริการ (money page) */}
    <RelatedServices class="max-w-3xl mx-auto mt-16" />
  </div>
</PageLayout>

<script>
  function setupSizeGuide() {
    const modal = document.getElementById('sizeguide-modal') as HTMLDialogElement;
    const openBtn = document.getElementById('btn-sizeguide');
    const closeBtn = document.getElementById('sizeguide-close');

    if (modal && openBtn && closeBtn) {
      openBtn.addEventListener('click', () => {
        modal.showModal();
        document.body.style.overflow = 'hidden';
      });

      const closeModal = () => {
        modal.close();
        document.body.style.overflow = '';
      };

      closeBtn.addEventListener('click', closeModal);
      
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });
    }
  }

  document.addEventListener('astro:page-load', setupSizeGuide);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSizeGuide);
  } else {
    setupSizeGuide();
  }
</script>
